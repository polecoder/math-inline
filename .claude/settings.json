{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run check-types)",
      "Bash(npm run lint)",
      "Bash(npm run compile)",
      "Bash(npm run compile-tests)",
      "Bash(npm audit)",
      "Bash(npm audit --json)",
      "Bash(npm ls:*)",
      "Bash(npm view:*)",
      "Bash(npx vsce ls)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git describe:*)",
      "Bash(git merge-base:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/package-json-cambio.mjs\""
          }
        ]
      }
    ]
  }
}
